# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — Project Settings → Database → Connection string → URI
# Use the "Direct connection" URL locally; "Transaction pooler" URL on Vercel.
DATABASE_URL=

# Anthropic — console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=

# Resend — resend.com → API Keys (free tier; sandbox uses onboarding@resend.dev)
# Leaving these unset puts alerts in queued-only mode (logged but not delivered).
RESEND_API_KEY=
ALERT_FROM_EMAIL="Crazy Brownies Ops <onboarding@resend.dev>"

# Optional: protects /api/cron/* endpoints with `Authorization: Bearer …`.
# Vercel Cron sends this automatically when configured under Project Settings.
CRON_SECRET=

# Demo "live traffic" generator. Set to "true" only during the recording
# window; the simulator drops 1–3 synthetic orders every 2 minutes.
SIMULATOR_ON=
